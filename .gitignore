# Build output
/build/
/cmake-build-*/
*.o
*.obj
*.a
*.so
*.dylib
*.exe
/bezelc

# Tooling
/.cache/
compile_commands.json
.vscode/
.idea/
__pycache__/

# Blessed root scratch dir for probes / experiments / one-off investigations.
# Put ad-hoc .bz probes and compiled probe binaries HERE (or in
# /var/tmp/bezel-scratch) — never loose in the repo root. See CLAUDE.md.
# scripts/gc_scratch.sh auto-quarantines strays that still land in the root.
/scratch/

# Local scheduler lock files (per-session)
.claude/scheduled_tasks.lock

# lit hand-run fallback writes these in-tree (lit.cfg.py test_exec_root); #5265
/tests/lit/.lit_test_times.txt
tests/lit/**/Output/

# A hand-run `lit tests/lit` without `-Dtest_exec_root` writes one extensionless
# build artifact per test NEXT TO ITS SOURCE — ~1119 of them under tests/lit/ in a
# single run, plus tree-root ELF objects from ad-hoc `--probe` compiles. Measured
# across several R28 worktrees: 2366 in one tree, 870 in another. They are
# untracked build output, never sources, and they turn `git status --porcelain`
# into a 2400-line wall that hides real WIP. Prefer `-Dtest_exec_root=<dir>`
# under /var/tmp; this is the belt-and-braces for the lanes that forget.
tests/lit/*[!.]
/tmp*
