{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bezel",
  "scopeName": "source.bezel",
  "fileTypes": [
    "bzl"
  ],
  "comment": "GENERATED by scripts/gen_editor_grammars.py from the language spec, Appendix A and B. Do not edit by hand.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#end-label"
    },
    {
      "include": "#contextual"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "///",
          "end": "$",
          "name": "comment.line.documentation.bezel"
        },
        {
          "begin": "//",
          "end": "$",
          "name": "comment.line.double-slash.bezel"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.bezel"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\\$@\"",
          "end": "\"(?!\")",
          "name": "string.quoted.double.interpolated.verbatim.bezel",
          "patterns": [
            {
              "match": "\"\"",
              "name": "constant.character.escape.bezel"
            },
            {
              "match": "\\{\\{|\\}\\}",
              "name": "constant.character.escape.bezel"
            },
            {
              "begin": "\\{(?!\\{)",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.bezel"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.bezel"
                }
              },
              "contentName": "meta.interpolation.bezel",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "begin": "\\$\"",
          "end": "\"",
          "name": "string.quoted.double.interpolated.bezel",
          "patterns": [
            {
              "match": "\\\\(?:[\\\\\\'\"0abfnrtv{}]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|x[0-9A-Fa-f]{1,4})",
              "name": "constant.character.escape.bezel"
            },
            {
              "match": "\\{\\{|\\}\\}",
              "name": "constant.character.escape.bezel"
            },
            {
              "begin": "\\{(?!\\{)",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.bezel"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.bezel"
                }
              },
              "contentName": "meta.interpolation.bezel",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "begin": "@\"",
          "end": "\"(?!\")",
          "name": "string.quoted.double.verbatim.bezel",
          "patterns": [
            {
              "match": "\"\"",
              "name": "constant.character.escape.bezel"
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.bezel",
          "patterns": [
            {
              "match": "\\\\(?:[\\\\\\'\"0abfnrtv{}]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|x[0-9A-Fa-f]{1,4})",
              "name": "constant.character.escape.bezel"
            }
          ]
        },
        {
          "match": "'(?:\\\\.|[^'\\\\])+'",
          "name": "string.quoted.single.bezel"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0x[0-9A-Fa-f](?:_*[0-9A-Fa-f])*(?:[uU][lL]?|[lL][uU]?)?\\b",
          "name": "constant.numeric.hex.bezel"
        },
        {
          "match": "\\b0b[01](?:_*[01])*(?:[uU][lL]?|[lL][uU]?)?\\b",
          "name": "constant.numeric.binary.bezel"
        },
        {
          "match": "\\b[0-9](?:_*[0-9])*(?:\\.[0-9](?:_*[0-9])*)?(?:[eE][+-]?[0-9](?:_*[0-9])*)?[fFmM]?\\b",
          "name": "constant.numeric.decimal.bezel"
        },
        {
          "match": "\\b[0-9](?:_*[0-9])*(?:[uU][lL]?|[lL][uU]?)\\b",
          "name": "constant.numeric.decimal.bezel"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.other.declaration.bezel"
            },
            "2": {
              "name": "entity.name.namespace.bezel"
            }
          }
        },
        {
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.other.declaration.bezel"
            },
            "2": {
              "name": "entity.name.namespace.bezel"
            }
          }
        },
        {
          "match": "\\b(class|interface|record|enum|choice|extension|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.declaration.bezel"
            },
            "2": {
              "name": "entity.name.type.bezel"
            }
          }
        },
        {
          "match": "\\b(method|property)\\s+(?:(operator)\\s*(<<|>>|<=|>=|<>|\\bmod\\b|[-+*/&|^<>=~])|([A-Za-z_][A-Za-z0-9_]*))",
          "captures": {
            "1": {
              "name": "keyword.other.declaration.bezel"
            },
            "2": {
              "name": "keyword.other.contextual.bezel"
            },
            "3": {
              "name": "entity.name.function.operator.bezel"
            },
            "4": {
              "name": "entity.name.function.bezel"
            }
          }
        }
      ]
    },
    "end-label": {
      "match": "\\b(end)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=;)",
      "captures": {
        "1": {
          "name": "keyword.control.bezel"
        },
        "2": {
          "name": "entity.name.label.bezel"
        }
      }
    },
    "contextual": {
      "patterns": [
        {
          "match": "\\b(where)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(\\s*(?:new\\s*\\(\\s*\\)|[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:<[^;:()<>]*(?:<[^;:()<>]*>[^;:()<>]*)*>)?\\??)(?:\\s*,\\s*(?:new\\s*\\(\\s*\\)|[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:<[^;:()<>]*(?:<[^;:()<>]*>[^;:()<>]*)*>)?\\??))*)",
          "captures": {
            "1": {
              "name": "keyword.other.bezel"
            },
            "2": {
              "name": "entity.name.type.parameter.bezel"
            },
            "4": {
              "patterns": [
                {
                  "match": "<.*>",
                  "captures": {
                    "0": {
                      "patterns": [
                        {
                          "include": "$self"
                        }
                      ]
                    }
                  }
                },
                {
                  "match": "\\b(?:hashable|sendable|notnull|value)\\b(?![\\w.])",
                  "name": "keyword.other.contextual.bezel"
                },
                {
                  "include": "$self"
                }
              ]
            }
          }
        },
        {
          "match": "\\b(pure)(?=\\s+(?:method|get|property|constructor|readonly|abstract|virtual|override|sealed|static|owned|public|private|protected|internal)\\b)",
          "name": "storage.modifier.contextual.bezel"
        },
        {
          "match": "\\b(scoped)(?=\\s+(?:readonly\\b|[A-Za-z_][A-Za-z0-9_]*\\s*[:,)]))",
          "name": "storage.modifier.contextual.bezel"
        },
        {
          "match": "^\\s*((?:(?:public|private|protected|internal)\\s+)?)(?:(pure)\\s+)?(get|set)\\b(?=\\s*(?:;|=>|\\(\\s*owned\\s*\\)|$))",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#keywords"
                }
              ]
            },
            "2": {
              "name": "storage.modifier.contextual.bezel"
            },
            "3": {
              "name": "keyword.other.contextual.bezel"
            }
          }
        },
        {
          "match": "\\b(public|private|protected|internal)\\s+(get|set)\\b(?=\\s*(?:;|:=|=>|\\(\\s*owned\\s*\\)))",
          "captures": {
            "1": {
              "name": "storage.modifier.bezel"
            },
            "2": {
              "name": "keyword.other.contextual.bezel"
            }
          }
        },
        {
          "begin": "\\b(ensures)\\s*(\\()",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.bezel"
            }
          },
          "patterns": [
            {
              "include": "#ensures-body"
            }
          ]
        },
        {
          "match": "\\b(case)\\b((?:(?!\\bof\\b|//|/\\*).)*?)\\b(of)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.bezel"
            },
            "2": {
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            },
            "3": {
              "name": "keyword.control.contextual.bezel"
            }
          }
        },
        {
          "begin": "\\b(case)\\b(?=(?:(?!\\bof\\b|//|/\\*).)*(?://.*)?$)",
          "end": "\\b(of)\\b|(?=;|=>|\\bend\\b)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.bezel"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.control.contextual.bezel"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "match": "(\\.\\.<?)(\\s*(?!step\\b)[^\\s;,\"{}](?:(?!\\bstep\\b|[;,\"{}]|=>|:=|\\b(?:do|then|of)\\b).)*?)\\s+(step)\\b(?=\\s*[-+(\\w])",
          "captures": {
            "1": {
              "name": "keyword.operator.bezel"
            },
            "2": {
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            },
            "3": {
              "name": "keyword.other.contextual.bezel"
            }
          }
        },
        {
          "begin": "\\b(extern)\\s+(\"(?:[^\"\\\\\\n]|\\\\.)*\")(?:\\s+(convention)\\s+(\"(?:[^\"\\\\\\n]|\\\\.)*\"))?",
          "end": "\\b(end)\\b(?:\\s+(extern)\\b)?(?=\\s*;)",
          "beginCaptures": {
            "1": {
              "name": "storage.modifier.bezel"
            },
            "2": {
              "name": "string.quoted.double.bezel"
            },
            "3": {
              "name": "keyword.other.contextual.bezel"
            },
            "4": {
              "name": "string.quoted.double.bezel"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.control.bezel"
            },
            "2": {
              "name": "storage.modifier.bezel"
            }
          },
          "patterns": [
            {
              "include": "#extern-body"
            }
          ]
        },
        {
          "match": "(:=)\\s*(symbol)\\s+(\"(?:[^\"\\\\\\n]|\\\\.)*\")(?:\\s*(variadic)(?=\\s*\\())?",
          "captures": {
            "1": {
              "name": "keyword.operator.assignment.bezel"
            },
            "2": {
              "name": "keyword.other.contextual.bezel"
            },
            "3": {
              "name": "string.quoted.double.bezel"
            },
            "4": {
              "name": "keyword.other.contextual.bezel"
            }
          }
        },
        {
          "match": "\\b(serialized)\\s+(?:(skip)\\b|(\"(?:[^\"\\\\\\n]|\\\\.)*\")(?:\\s+(optional)\\b)?|(optional)\\b)",
          "captures": {
            "1": {
              "name": "keyword.other.contextual.bezel"
            },
            "2": {
              "name": "keyword.other.contextual.bezel"
            },
            "3": {
              "name": "string.quoted.double.bezel"
            },
            "4": {
              "name": "keyword.other.contextual.bezel"
            },
            "5": {
              "name": "keyword.other.contextual.bezel"
            }
          }
        },
        {
          "match": "\\b(equality)\\s+(skip)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.contextual.bezel"
            },
            "2": {
              "name": "keyword.other.contextual.bezel"
            }
          }
        },
        {
          "match": "\\b(polymorphic)\\s*(?=\\(\\s*\"(?:[^\"\\\\\\n]|\\\\.)*\"\\s*:)",
          "captures": {
            "1": {
              "name": "keyword.other.contextual.bezel"
            }
          }
        },
        {
          "match": "\\b(static)\\s+(operator)\\s*(<<|>>|<=|>=|<>|\\bmod\\b|[-+*/&|^<>=~])",
          "captures": {
            "1": {
              "name": "storage.modifier.bezel"
            },
            "2": {
              "name": "keyword.other.contextual.bezel"
            },
            "3": {
              "name": "entity.name.function.operator.bezel"
            }
          }
        },
        {
          "match": "\\b(end)\\s+(operator)\\s*(<<|>>|<=|>=|<>|\\bmod\\b|[-+*/&|^<>=~])\\s*(?=;)",
          "captures": {
            "1": {
              "name": "keyword.control.bezel"
            },
            "2": {
              "name": "keyword.other.contextual.bezel"
            },
            "3": {
              "name": "entity.name.function.operator.bezel"
            }
          }
        }
      ]
    },
    "ensures-body": {
      "patterns": [
        {
          "match": "\\b(old)(?=\\s*\\()",
          "name": "keyword.other.contextual.bezel"
        },
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#ensures-body"
            }
          ]
        },
        {
          "include": "$self"
        }
      ]
    },
    "extern-body": {
      "patterns": [
        {
          "match": "(?:(?<=[(,])|^)\\s*\\b(env)\\b(?=\\s*[,)])",
          "captures": {
            "1": {
              "name": "keyword.other.contextual.bezel"
            }
          }
        },
        {
          "match": "\\b(variadic)\\s*(?=\\(\\s*[0-9])",
          "captures": {
            "1": {
              "name": "keyword.other.contextual.bezel"
            }
          }
        },
        {
          "include": "$self"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:false|null|true)\\b",
          "name": "constant.language.bezel"
        },
        {
          "match": "\\b(?:base|this)\\b",
          "name": "variable.language.bezel"
        },
        {
          "match": "\\b(?:decimal|double|string|ushort|float|sbyte|short|ulong|bool|byte|char|long|uint|int)\\b",
          "name": "storage.type.primitive.bezel"
        },
        {
          "match": "\\b(?:protected|abstract|internal|override|readonly|private|virtual|closed|extern|public|sealed|static|async|const|owned|out|ref)\\b",
          "name": "storage.modifier.bezel"
        },
        {
          "match": "\\b(?:constructor|destructor|extension|interface|property|choice|import|lambda|method|module|record|class|enum|type|var)\\b",
          "name": "keyword.other.declaration.bezel"
        },
        {
          "match": "\\b(?:and|mod|not|as|in|is|or)\\b",
          "name": "keyword.operator.word.bezel"
        },
        {
          "match": "\\b(?:invariant|requires|default|ensures|nameof|typeof|where|new)\\b",
          "name": "keyword.other.bezel"
        },
        {
          "match": "\\b(?:continue|finally|return|await|break|catch|throw|using|while|yield|case|elif|else|move|then|when|with|end|for|try|do|if)\\b",
          "name": "keyword.control.bezel"
        }
      ]
    },
    "types": {
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.bezel"
    },
    "operators": {
      "patterns": [
        {
          "match": ":=|\\+=|-=|\\*=|/=|\\?\\?=",
          "name": "keyword.operator.assignment.bezel"
        },
        {
          "match": "=>|->",
          "name": "keyword.operator.arrow.bezel"
        },
        {
          "match": "\\?\\?|\\?\\.|\\?\\[|!(?![=])",
          "name": "keyword.operator.null.bezel"
        },
        {
          "match": "<=|>=|<>|=|<|>",
          "name": "keyword.operator.comparison.bezel"
        },
        {
          "match": "\\.\\.<|\\.\\.|\\+|-|\\*|/|%|&|\\||\\^|~|<<|>>",
          "name": "keyword.operator.bezel"
        }
      ]
    }
  }
}
