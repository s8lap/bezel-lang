{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((public|private|protected|internal|static|abstract|sealed|closed|owned|override|virtual|async|pure|readonly|extern)\\s+)*(class|interface|record|enum|choice|extension|method|property|constructor|destructor|get|set)\\b(?!.*(=>|;\\s*$)).*$|^\\s*(if|elif|while|for|try|case)\\b.*\\b(then|do|of)?\\s*$|^\\s*(else|catch|finally|do)\\b.*$|\\bthen\\s*$|\\bdo\\s*$",
    "decreaseIndentPattern": "^\\s*(end\\b|else\\b|elif\\b|catch\\b|finally\\b)"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*///.*$",
      "action": { "indent": "none", "appendText": "/// " }
    }
  ],
  "folding": {
    "offSide": false
  }
}
