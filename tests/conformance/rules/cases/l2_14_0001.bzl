//! case: l2_14_0001
//! doc: stdlib
//! section: 2.14
//! title: a record declaring both serialization interfaces needs no body
//! rule: A record that declares : ISerializable and/or : IDeserializable and
//!   satisfies the synthesis-eligibility rule has the bodies generated by
//!   the compiler — the hand-written forms are unnecessary for the common
//!   case.
//! cites: 2.14
//! expect: accept
module Conf;

public record Point(X: int, Y: int): ISerializable, IDeserializable;
